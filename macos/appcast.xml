      <title>Tera Term Mac 0.4.4</title>
      <pubDate>Wed, 25 Nov 2026 02:01:07 +0000</pubDate>
      <sparkle:version>0.4.4</sparkle:version>
      <sparkle:shortVersionString>0.4.4</sparkle:shortVersionString>
