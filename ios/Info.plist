<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac 版との連携 (近くの Mac を探す) -->
	<key>NSBonjourServices</key>
	<array><string>_teraterm-link._tcp</string></array>
	<!-- Handoff: Mac で開いている接続の続き -->
	<key>NSUserActivityTypes</key>
	<array><string>net.satoru.teraterm.session</string></array>
	<!-- Mac の画面の QR コードを iPhone のカメラで読むと開く (teraterm-sp://pair?...) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key><string>net.satoru.terasp.pair</string>
			<key>CFBundleURLSchemes</key><array><string>teraterm-sp</string></array>
		</dict>
	</array>
	<!-- 画面はシーンで作る (SceneDelegate。新しい iOS では必須) -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key><false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key><string>Default</string>
					<key>UISceneDelegateClassName</key><string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
